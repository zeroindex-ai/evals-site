{
  "name": "evals-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "description": "Public eval reports from ZeroIndex projects, served at evals.zeroindex.ai",
  "type": "module",
  "scripts": {
    "render": "tsx render.ts",
    "build:css": "tailwindcss -i src/styles/input.css -o public/styles/zeroindex.css --minify",
    "build:css:watch": "tailwindcss -i src/styles/input.css -o public/styles/zeroindex.css --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "serve public",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^26.4.1",
    "@zeroindex-ai/eval-pack": "^0.3.0",
    "prettier": "^3.8.4",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.6": ">=3.1.6",
      "postcss@<8.5.23": ">=8.5.23",
      "brace-expansion@<1.1.18": ">=1.1.18 <2"
    }
  }
}
