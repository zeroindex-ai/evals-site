{
  "name": "evals-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "description": "Public eval reports from ZeroIndex projects, served at evals.zeroindex.ai",
  "type": "module",
  "scripts": {
    "render": "tsx render.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@zeroindex-ai/eval-pack": "^0.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
